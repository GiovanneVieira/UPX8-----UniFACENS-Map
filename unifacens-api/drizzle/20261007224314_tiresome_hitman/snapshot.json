      "entityType": "checks",
      "schema": "public",
      "table": "places"
    },
    {
      "value": "\"source\" IN ('team_report', 'field_survey', 'demo')",
      "name": "places_source_values",
      "entityType": "checks",
      "schema": "public",
      "table": "places"
    },
    {
      "value": "\"verification_status\" IN ('unverified', 'verified')",
      "name": "places_verification_values",
      "entityType": "checks",
      "schema": "public",
      "table": "places"
    },
    {
      "value": "(\"verification_status\" = 'unverified' AND \"verified_at\" IS NULL) OR (\"verification_status\" = 'verified' AND \"verified_at\" IS NOT NULL)",
