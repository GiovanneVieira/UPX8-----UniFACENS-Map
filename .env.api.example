# ==============================================================================
# Exemplo de Variáveis de Ambiente - unifacens-api & Banco de Dados
# Copie para .env.api: cp .env.api.example .env.api
# ==============================================================================
NODE_ENV=development
PORT=8000

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=unifacens_map

# String de Conexão
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/unifacens_map

# Neon: copie a URL completa (com SSL) no painel do Render, somente na API.
# URL direta opcional para migrações; vazia reutiliza DATABASE_URL.
DATABASE_MIGRATION_URL=

# ── better-auth (autenticação JWT + roles) ────────────────────────────────────
# URL pública da API (usada como issuer/audience do JWT e pelo JWKS interno).
BETTER_AUTH_URL=http://127.0.0.1:8000
# Em produção, obrigatório (32+ caracteres). Nunca usar EXPO_PUBLIC_ neste segredo.
BETTER_AUTH_SECRET=
# Credenciais do admin inicial (seed idempotente via `npm run db:seed-admin`
# dentro de unifacens-api; também roda automaticamente no start:dev).
ADMIN_EMAIL=admin@facens.dev
ADMIN_PASSWORD=12345678
# Origens separadas por vírgula, sem caminho. Ex.: https://SEU-FRONT.onrender.com
# Em produção, vazio bloqueia CORS; no desenvolvimento, vazio permite a rede local.
CORS_ORIGINS=
# Schemes de app nativo (better-auth trustedOrigins), CSV no formato scheme://.
# O plugin expo envia `expo-origin: unifacensclient://` e o servidor valida essa
# origem no sign-in — SEM o scheme listado, todo login do APK em produção
# retorna 403 INVALID_ORIGIN ("Invalid origin: unifacensclient://" no log).
TRUSTED_APP_ORIGINS=unifacensclient://

# ── OTP (better-auth emailOTP) ────────────────────────────────────────────────
# Redis para códigos OTP + rate-limits (secondaryStorage). Vazio = fallback
# para a verification table do Postgres (dev local sem Redis funciona).
# No docker compose a API recebe redis://redis:6379 automaticamente.
REDIS_URL=
# Envio dos OTPs por e-mail (nodemailer). OBRIGATÓRIA em produção: com
# requireEmailVerification ativo, a API não boota sem ela (fail-fast — novos
# usuários não verificam conta sem e-mail de verdade). Formato:
# smtp://usuario:senha@host:587 (STARTTLS) ou smtps://...:465 (TLS).
SMTP_URL=
# Remetente dos e-mails. Ex.: UniFACENS Map <no-reply@facens.br>
SMTP_FROM=
# Em desenvolvimento (SMTP_URL vazio), o OTP é logado no console da API.

# Observability
OBSERVE_APP_KEY=YOUR_APP_KEY
OBSERVE_APP_SECRET=YOUR_APP_SECRET

# ── Storage de arquivos (S3 em produção, disco local em dev) ──────────────────
# local = grava em unifacens-api/uploads (servido em /uploads); s3 = bucket público
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=sa-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Endpoint opcional p/ providers S3-compatíveis (R2/B2/MinIO). Vazio = AWS.
S3_ENDPOINT=
# Base pública do bucket (ex.: https://unifacens-map.s3.sa-east-1.amazonaws.com)
S3_PUBLIC_BASE_URL=
# Prefixo de pasta por ambiente (dev/ ou prod/). Vazio = automático:
# "prod" quando NODE_ENV=production, "dev" caso contrário.
STORAGE_PREFIX=
