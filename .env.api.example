# ==============================================================================
# Exemplo de Variáveis de Ambiente - unifacens-api & Banco de Dados
# Copie para .env.api: cp .env.api.example .env.api
# ==============================================================================
NODE_ENV=development
PORT=8000

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=unifacens_map

# String de Conexão
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/unifacens_map

# Neon: copie a URL completa (com SSL) no painel do Render, somente na API.
# URL direta opcional para migrações; vazia reutiliza DATABASE_URL.
DATABASE_MIGRATION_URL=

# ── better-auth (autenticação JWT + roles) ────────────────────────────────────
# URL pública da API (usada como issuer/audience do JWT e pelo JWKS interno).
BETTER_AUTH_URL=http://127.0.0.1:8000
# Em produção, obrigatório (32+ caracteres). Nunca usar EXPO_PUBLIC_ neste segredo.
BETTER_AUTH_SECRET=
# Credenciais do admin inicial (seed idempotente via `npm run db:seed-admin`
# dentro de unifacens-api; também roda automaticamente no start:dev).
ADMIN_EMAIL=admin@facens.dev
ADMIN_PASSWORD=
# Origens separadas por vírgula, sem caminho. Ex.: https://SEU-FRONT.onrender.com
# Em produção, vazio bloqueia CORS; no desenvolvimento, vazio permite a rede local.
CORS_ORIGINS=

# Observability
OBSERVE_APP_KEY=YOUR_APP_KEY
OBSERVE_APP_SECRET=YOUR_APP_SECRET
