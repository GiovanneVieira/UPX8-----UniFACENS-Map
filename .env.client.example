# ==============================================================================
# Exemplo de Variáveis de Ambiente - unifacens-client (Expo SDK 57)
# Copie para .env.client: cp .env.client.example .env.client
# ==============================================================================
NODE_ENV=development

# IP da máquina na rede Wi-Fi para o Metro Bundler / Expo Go (obtenha via: hostname -I)
REACT_NATIVE_PACKAGER_HOSTNAME=192.168.x.x

# URL da API para consumo pelo aplicativo móvel e web
EXPO_PUBLIC_API_URL=http://192.168.x.x:8000
API_URL=http://192.168.x.x:8000

# Configurações do Expo no Docker
EXPO_DEVTOOLS_LISTEN_ADDRESS=0.0.0.0
EXPO_OFFLINE=1

# Google ARCore API Key (Cloud Anchors & Geospatial VPS)
EXPO_PUBLIC_GOOGLE_AR_API_KEY=AIzaSyD6v6hiDGXW_DEfg9bZms-pkNRbyRcdAU8

# Mapa 2D: opcionais nesta etapa. Sem chave, cadastro e lista continuam disponíveis.
# Web: Maps JavaScript API, restrita aos domínios autorizados.
EXPO_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=AIzaSyAlOXn9pKNdtKUBZa0joZ-74Cbq_KKx0RQ
# Android: Maps SDK for Android, restrita ao package/SHA-1 do aplicativo.
# Depois de configurar, gere novamente o development build Android.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=AIzaSyAlOXn9pKNdtKUBZa0joZ-74Cbq_KKx0RQ

