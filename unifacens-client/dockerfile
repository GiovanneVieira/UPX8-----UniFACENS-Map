# ==============================================================================
# Dockerfile para unifacens-client (Expo SDK 57 + React 19 + NativeWind + Node.js 24 LTS)
# Contexto de Build: Raiz do Monorepo (.)
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Base (Debian Bookworm Slim com Node 24 LTS)
# ------------------------------------------------------------------------------
FROM node:24-bookworm-slim AS base
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates libglib2.0-0 libnss3 libnspr4 libdbus-1-3 procps && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------------------------
# Stage 2: Instalação das dependências do monorepo
# ------------------------------------------------------------------------------
FROM base AS dependencies

# Copia manifests para cache de camadas Docker
COPY package.json package-lock.json ./
COPY packages/shared/package.json ./packages/shared/
COPY unifacens-api/package.json ./unifacens-api/
COPY unifacens-client/package.json ./unifacens-client/
COPY scripts ./scripts

# Instala todas as dependências respeitando os workspaces do npm
RUN npm ci

# ------------------------------------------------------------------------------
# Stage 3: Ambiente de Desenvolvimento (Metro Bundler / Expo Web)
# ------------------------------------------------------------------------------
FROM dependencies AS development
ENV NODE_ENV=development
ENV NODE_PATH=/app/unifacens-client/node_modules:/app/node_modules
WORKDIR /app

COPY packages/shared ./packages/shared
COPY unifacens-client ./unifacens-client

# Porta padrão do Metro Bundler e Expo Web
EXPOSE 8081

WORKDIR /app/unifacens-client
CMD ["sh", "-c", "npm run build --workspace=shared && npx expo start --port 8081 --offline"]

# ------------------------------------------------------------------------------
# Stage 4: Builder de Produção (Exportação estática Web do Expo)
# ------------------------------------------------------------------------------
FROM dependencies AS builder
ENV NODE_ENV=production
WORKDIR /app

COPY packages/shared ./packages/shared
COPY unifacens-client ./unifacens-client

# Exporta a versão web estática para a pasta dist
RUN npm run build --workspace=shared
RUN npx --workspace=unifacens-client expo export --platform web

# ------------------------------------------------------------------------------
# Stage 5: Runner de Produção (Nginx para servir os arquivos estáticos)
# ------------------------------------------------------------------------------
FROM nginx:alpine AS runner

# Copia a configuração customizada do Nginx com suporte a SPA
COPY unifacens-client/nginx.conf /etc/nginx/conf.d/default.conf

# Copia os arquivos gerados pelo export do Expo
COPY --from=builder /app/unifacens-client/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
