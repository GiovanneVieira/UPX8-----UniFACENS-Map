    "typescript": "~5.9.3"
  },
  "workspaces": [
    "./packages/*",
    "./unifacens-api",
    "./unifacens-client"
  ],
  "optionalDependencies": {
    "@oxlint-tsgolint/win32-x64": "^7.0.2004",
    "@oxlint/binding-win32-x64-msvc": "^1.89.0",
    "@rolldown/binding-win32-x64-msvc": "^1.2.15"
